# Copy this file to .env and change what you need. Every value has a default.

# development | production
ENVIRONMENT=development

# Long random string. Required in production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# SQLite file by default. For Postgres (needs `pip install "psycopg[binary]"`):
# DATABASE_URL=postgresql://triagecare:triagecare@localhost:5432/triagecare
# DATABASE_URL=sqlite:///triagecare.db

TIMEZONE=Asia/Karachi
HOSPITAL_NAME=City General Hospital

# Show one-click demo accounts on the login page
DEMO_MODE=true
DEMO_PASSWORD=triage123
